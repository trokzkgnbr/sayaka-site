# Instagram Graph API（このファイルをコピーして instagram.env を作る）
# 手順: docs/INSTAGRAM_DIARY_SETUP.md
#
# Diary 同期元: @4mnion（サイトヘッダー SNS の @pikinsaya とは別）
# Meta トークンは @4mnion にリンクした Facebook ページ／プロアカウントで取得すること

# Meta で発行したアクセストークン（ページトークン・長期推奨）
INSTAGRAM_ACCESS_TOKEN=

# scripts/get_instagram_user_id.py で取得した ID
INSTAGRAM_USER_ID=

# トークン自動延長用（Meta アプリ → 設定 → ベーシック。Git にコミットしない）
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# 同期する投稿数（最大 200、既定 50）
INSTAGRAM_SYNC_LIMIT=50
