# Blog 管理サーバー用（Git にコミットしない）
# ローカル: bash scripts/run_diary_admin.sh
# 外出先: docs/DIARY_ADMIN_REMOTE.md（Render 等）

# scripts/setup_admin_password.sh が生成（平文パスワードは保存しない）
ADMIN_PASSWORD_HASH=

# セッション署名用（自動生成）
SESSION_SECRET=

# 管理画面 URL の秘密パス（/admin より推測されにくい文字列）
# 例: bash scripts/generate_admin_path.sh
ADMIN_PATH=admin

# ローカル listen（外出先公開時は 0.0.0.0 + Render 等）
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8765

# HTTPS 公開時（Render 等）: 1
ADMIN_HTTPS=

# 外出先公開時の完全 URL（末尾スラッシュなし・Render の URL 等）
# 例: https://sayaka-blog-admin.onrender.com
ADMIN_PUBLIC_URL=

# 投稿・削除後に GitHub へ自動 push（repo 権限付き PAT）
GITHUB_TOKEN=
GITHUB_REPO=trokzkgnbr/sayaka-site
GITHUB_BRANCH=main
